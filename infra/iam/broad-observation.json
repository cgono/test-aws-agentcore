{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BroadObservationOnly",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:*",
      "Resource": "*"
    },
    {
      "Sid": "BroadObservationOauth2ProviderSecretAccess",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "*"
    }
  ]
}
